POSTGRES_DB=searchlens
POSTGRES_USER=searchlens
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT=10s

# Uncomment to run PostgreSQL integration tests against this database.
# TEST_DATABASE_URL=${DATABASE_URL}
