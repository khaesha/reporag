POSTGRES_DB=searchlens
POSTGRES_USER=searchlens
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable"
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
REQUEST_TIMEOUT=10s

# Uncomment to run PostgreSQL integration tests against this database.
# TEST_DATABASE_URL=${DATABASE_URL}

OPENROUTER_API_KEY=

# Supabase administrative connection for migrations, imports, embeddings, and backups.
# Keep it in an ignored environment file; use sslmode=verify-full remotely.
ADMIN_DATABASE_URL=
